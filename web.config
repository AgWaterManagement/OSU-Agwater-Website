<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
		<cors enabled="true" failUnlistedOrigins="true">
			<add origin="*">
				<allowHeaders allowAllRequestedHeaders="true" />
				<allowMethods>
					<add method="GET" />
					<add method="POST" />
					<add method="PUT" />
					<add method="DELETE" />
				</allowMethods>
			</add>
		</cors>
    </system.webServer>
	<appSettings>
    </appSettings>

</configuration>